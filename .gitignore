# Terraform
# Local .terraform directories (provider binaries, modules)
**/.terraform/*
.terraform.lock.hcl.bak

# State files - may contain secrets, keep out of git
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# CLI override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan
*.tfplan.*
